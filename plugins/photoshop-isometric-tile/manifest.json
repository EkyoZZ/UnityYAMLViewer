{
  "manifestVersion": 5,
  "id": "unityyamlviewer.isometric-preview",
  "name": "Isometric Tile Preview",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.4.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "tilePreview",
      "label": {
        "default": "Tile 设置"
      },
      "minimumSize": {
        "width": 240,
        "height": 320
      },
      "preferredDockedSize": {
        "width": 280,
        "height": 700
      },
      "preferredFloatingSize": {
        "width": 280,
        "height": 700
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "tile-dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ],
          "species": [
            "generic"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "tile-light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ],
          "species": [
            "generic"
          ]
        }
      ],
      "maximumSize": {
        "width": 7680,
        "height": 4320
      }
    },
    {
      "type": "panel",
      "id": "tilePreviewView",
      "label": {
        "default": "Tile 预览"
      },
      "minimumSize": {
        "width": 360,
        "height": 320
      },
      "preferredDockedSize": {
        "width": 800,
        "height": 650
      },
      "preferredFloatingSize": {
        "width": 900,
        "height": 700
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "tile-dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ],
          "species": [
            "generic"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "tile-light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ],
          "species": [
            "generic"
          ]
        }
      ],
      "maximumSize": {
        "width": 7680,
        "height": 4320
      }
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "tile-dark.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium"
      ],
      "species": [
        "generic"
      ]
    },
    {
      "width": 23,
      "height": 23,
      "path": "tile-light.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "lightest",
        "light"
      ],
      "species": [
        "generic"
      ]
    }
  ],
  "requiredPermissions": {
    "ipc": {
      "enablePluginCommunication": true
    }
  }
}
